/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted: cache for a day, then revalidate.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Written at build time and used to check which build is live: never stale.
/version.json
  Cache-Control: no-cache
